<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_group_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Name and Private Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="CCS Friends" />

        <TextView
            android:id="@+id/group_privacy_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_group_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/groups_badge_private"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/group_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/groups_chevron_description"
            android:src="@drawable/ic_chevron_right" />

    </LinearLayout>

    <!-- Subtitle Line: Member count and update status -->
    <TextView
        android:id="@+id/group_status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="5 members · Updated just now" />

    <!-- Bottom Row: Member Avatars and Presence Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Member Avatars Row -->
        <LinearLayout
            android:id="@+id/group_avatars_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_group_avatar"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="MS" />

            <TextView
                android:id="@+id/avatar_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_group_avatar"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="JP" />

            <TextView
                android:id="@+id/avatar_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_group_avatar"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="AK" />

            <TextView
                android:id="@+id/avatar_overflow"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_group_avatar"
                android:gravity="center"
                android:textColor="@color/accent_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="+2" />

        </LinearLayout>

        <!-- Presence Summary -->
        <TextView
            android:id="@+id/group_presence_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="3 members on campus" />

    </LinearLayout>

</LinearLayout>
