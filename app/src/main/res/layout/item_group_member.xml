<?xml version="1.0" encoding="utf-8"?>
<!-- One member in Group Details: picture, name, username, and shared building. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_group_card"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Avatar: their photo if they have one, otherwise their initials -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/tvMemberInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_avatar"
            android:gravity="center"
            android:textColor="@color/highlight_selected"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="MS" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMemberPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimoMap.Circle"
            app:strokeColor="@color/accent_teal"
            app:strokeWidth="2dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Mika S." />

        <TextView
            android:id="@+id/tvMemberUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            tools:text="\@mika_s" />

        <!-- Shared building and last update, or "Not sharing their location" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMemberPresenceIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_community_location" />

            <TextView
                android:id="@+id/tvMemberPresence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="Gokongwei Hall · Updated 2 minutes ago" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden on your own row, since tapping it doesn't open a profile -->
    <ImageView
        android:id="@+id/ivMemberChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
