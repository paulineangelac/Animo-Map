<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="104dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/community_preview_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_community_dropdown"
        android:contentDescription="@string/community_photo_preview_description"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/community_preview_remove"
        style="@style/CommunityComposerAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|top"
        android:text="@string/community_remove_symbol"
        android:textSize="22sp" />
</FrameLayout>
