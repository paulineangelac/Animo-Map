<?xml version="1.0" encoding="utf-8"?>
<!-- One category filter chip, inflated for the filter row inside the search panel. -->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:textColor="@color/map_filter_chip_text"
    android:textSize="14sp"
    app:chipMinHeight="48dp"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/map_filter_chip_background"
    app:chipCornerRadius="18dp"
    app:chipStrokeColor="@color/map_filter_chip_stroke"
    app:chipStrokeWidth="0dp" />
