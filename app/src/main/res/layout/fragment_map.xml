<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mapbox.maps.MapView
        android:id="@+id/mapbox_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/map_canvas_description" />
    <LinearLayout
        android:id="@+id/map_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="4dp">
        <com.google.android.material.card.MaterialCardView
            android:id="@id/map_search_card"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_elevated">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_map_search"
                    android:importantForAccessibility="no"
                    app:tint="@color/accent_teal" />
                <AutoCompleteTextView
                    android:id="@+id/et_map_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/map_search_hint"
                    android:completionThreshold="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp"
                    android:popupBackground="@color/surface_card"
                    android:saveEnabled="false" />
                <ImageButton
                    android:id="@+id/btn_clear_map_search"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/map_clear_search"
                    android:src="@drawable/ic_map_close"
                    android:padding="14dp"
                    app:tint="@color/text_secondary"
                    android:visibility="invisible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <HorizontalScrollView
            android:id="@id/map_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/map_filter_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="6dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/map_filter_all"
                    android:textColor="@color/map_filter_chip_text"
                    android:textSize="14sp"
                    app:chipMinHeight="48dp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/map_filter_chip_background"
                    app:chipStrokeColor="@color/map_filter_chip_stroke"
                    app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_buildings"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="false"
                    android:text="@string/map_filter_buildings"
                    android:textColor="@color/map_filter_chip_text"
                    android:textSize="14sp"
                    app:chipMinHeight="48dp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/map_filter_chip_background"
                    app:chipStrokeColor="@color/map_filter_chip_stroke"
                    app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_study"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="false"
                    android:text="@string/map_filter_study"
                    android:textColor="@color/map_filter_chip_text"
                    android:textSize="14sp"
                    app:chipMinHeight="48dp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/map_filter_chip_background"
                    app:chipStrokeColor="@color/map_filter_chip_stroke"
                    app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_food"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="false"
                    android:text="@string/map_filter_food"
                    android:textColor="@color/map_filter_chip_text"
                    android:textSize="14sp"
                    app:chipMinHeight="48dp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/map_filter_chip_background"
                    app:chipStrokeColor="@color/map_filter_chip_stroke"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/map_controls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical">
        <ImageButton
            android:id="@+id/btn_map_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_map_control"
            android:src="@drawable/ic_map_plus"
            android:padding="13dp"
            android:contentDescription="@string/map_zoom_in"
            app:tint="@color/text_primary" />
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <ImageButton
            android:id="@+id/btn_map_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_map_control"
            android:src="@drawable/ic_map_minus"
            android:padding="13dp"
            android:contentDescription="@string/map_zoom_out"
            app:tint="@color/text_primary" />
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <ImageButton
            android:id="@+id/btn_map_overview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_map_control"
            android:src="@drawable/ic_map_overview"
            android:padding="13dp"
            android:contentDescription="@string/map_show_campus"
            app:tint="@color/text_primary" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_map_token_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="@string/map_token_missing"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_map_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/surface_elevated"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp">
                <TextView
                    android:id="@+id/tv_map_place_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/btn_close_map_place"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_map_close"
                    android:padding="14dp"
                    android:contentDescription="@string/map_close_place"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
            <ScrollView
                android:id="@id/map_place_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">
                    <TextView
                        android:id="@+id/tv_map_place_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_map_place_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_map_directions_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_map_directions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/map_preview_demo"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/primary_teal" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
